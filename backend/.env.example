# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Set to True to use local SQLite instead of MySQL (quick start / testing)
USE_SQLITE=False

# MySQL (used when DATABASE_URL is not set)
DB_NAME=ai_devworkspace
DB_USER=root
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306

# If set, takes priority over everything above. Render's managed Postgres
# sets this automatically when you link a database to the web service.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS - frontend origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enable real LLM-enriched responses. Leave blank to run fully
# on the offline rule-based AI engine (all features still work).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

AI_DAILY_QUOTA_PER_USER=200
MAX_UPLOAD_SIZE_MB=5
